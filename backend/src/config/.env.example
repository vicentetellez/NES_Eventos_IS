# Entorno de ejecución de la aplicación (development, production, etc.)
NODE_ENV=
# Atributo Secure de la cookie de sesión (true/false). Si se omite, es false solo en production. Usar false únicamente si se sirve por HTTP
COOKIE_SECURE=
# Puerto en el que correrá la API de Express
PORT=
# URL de conexión a la base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/NES_Eventos?schema=public"
# URL del frontend, Vite
FRONTEND_URL=
# Clave secreta para la creación de tokens JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" o con "openssl rand -hex 64" en linux
JWT_SECRET=
# Argon2 configuration
ARGON2_TYPE=argon2id
ARGON2_MEMORY_COST=15630
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4